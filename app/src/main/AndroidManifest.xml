<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_REMOTE_MESSAGING" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- Voice calls. The microphone service type is what keeps capture alive with the app in the
         background, and it is started only when the user has answered. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Revocable by the user from Android 14; CallNotificationManager.canRingFullScreen()
         checks it and falls back to a heads-up notification. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_CONNECT"
        android:minSdkVersion="31" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- In-app updater installs the APK it downloaded from the GitHub release. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />

    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <!-- Transport security is pinned by res/xml/network_security_config.xml:
         cleartext is refused in release builds; the debug overlay allows it for
         the emulator/LAN dev bootstrap only. -->
    <application
        android:name=".VMessengerApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.VMessenger">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.VMessenger.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!--
              Share target. Plain text arrives as EXTRA_TEXT, everything else as EXTRA_STREAM;
              singleTask means a share into a live process lands in onNewIntent.
            -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!--
          The call screen, in its own task so a ringing call can come up over the keyguard without
          putting the rest of the app there. It shows a name, a state and the call buttons; it is
          not a way past the app lock. Not exported: only this app's own notification opens it.
        -->
        <activity
            android:name=".CallActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:showOnLockScreen="true"
            android:taskAffinity=""
            android:theme="@style/Theme.VMessenger" />

        <!--
          No AppLocalesMetadataHolderService / autoStoreLocales, on purpose. AppLocaleController
          persists the per-app language itself; AppCompat's copy was a second store, and its
          one-time migration to the platform on Android 13+ overwrote the first-launch pin.
        -->

        <!-- remoteMessaging (API 34+) is exempt from Android 15's 6 h dataSync cap
             and from the Android 14 BOOT_COMPLETED start restrictions; dataSync
             stays declared as the pre-34 fallback type. -->
        <service
            android:name=".app.network.NetworkLifecycleService"
            android:exported="false"
            android:foregroundServiceType="remoteMessaging|dataSync" />

        <service
            android:name="ir.vmessenger.core.location.LocationService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- Declares the open microphone for the length of a call, so the privacy indicator and
             the shade both say what is happening. Started only once the call is answered. -->
        <service
            android:name=".app.call.CallForegroundService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- The answer / decline / hang-up buttons on the call notification. Not exported: the
             only sender is this app's own PendingIntent. -->
        <receiver
            android:name=".app.call.CallActionReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="ir.vmessenger.call.ACCEPT" />
                <action android:name="ir.vmessenger.call.DECLINE" />
                <action android:name="ir.vmessenger.call.HANG_UP" />
            </intent-filter>
        </receiver>

        <!-- Not direct-boot aware on purpose: the database key is unwrapped from
             the Keystore only after the user has unlocked the device once. -->
        <receiver
            android:name=".app.network.BootCompletedReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".app.network.LocationSharingStopReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="ir.vmessenger.location.STOP_SHARING" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- WorkManager is initialized on demand from VMessengerApplication
             (Configuration.Provider) so the Hilt worker factory is in place. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>

</manifest>
