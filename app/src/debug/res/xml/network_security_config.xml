<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug overlay of the release config: cleartext stays off everywhere except the
  local development hosts used by the two-emulator setup (10.0.2.2 is the host
  machine as seen from an emulator). Never shipped in a release build.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
