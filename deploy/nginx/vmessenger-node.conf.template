# vMessenger DHT + relay node — nginx site (rendered by scripts/setup-node.sh).
# Placeholders: __SERVER_NAME__  __NODE_PORT__  __CERT_DIR__  __PUBLIC_PORT__  __DEFAULT_SERVER__
# Lines marked @HTTP@ are dropped when the node serves no plain HTTP (--no-http, or port 80 taken),
# and lines marked @IPV6@ on a host without IPv6, where nginx would refuse to start.
#
# The JVM node listens on 127.0.0.1:__NODE_PORT__ over plain HTTP; nginx owns
# TLS and the public :80/:443 surface. When the host sits behind a CDN
# (Arvan), the real client IP is restored by the snippet below, which
# setup-node.sh --behind-cdn writes from deploy/nginx/arvan-ips.conf.
# The snippet must exist even when empty.
include /etc/nginx/snippets/vmessenger-realip.conf;

limit_req_zone  $binary_remote_addr zone=vm_dht:10m   rate=30r/s;
limit_conn_zone $binary_remote_addr zone=vm_relay:10m;

server {                                                                          # @HTTP@
    listen 80;                                                                    # @HTTP@
    listen [::]:80;                                                               # @HTTP@ @IPV6@
    server_name __SERVER_NAME__;                                                  # @HTTP@
                                                                                  # @HTTP@
    # ACME HTTP-01 (certbot --webroot). Kept on :80 and the TLS port so issuance  # @HTTP@
    # works whether or not a CDN forces an HTTPS redirect before reaching us.     # @HTTP@
    location ^~ /.well-known/acme-challenge/ {                                    # @HTTP@
        root /var/www/acme;                                                       # @HTTP@
        default_type text/plain;                                                  # @HTTP@
    }                                                                             # @HTTP@
                                                                                  # @HTTP@
    location / {                                                                  # @HTTP@
        return 301 https://$host:__PUBLIC_PORT__$request_uri;                     # @HTTP@
    }                                                                             # @HTTP@
}                                                                                 # @HTTP@

# No http2: the app's WebSockets are HTTP/1.1 upgrades either way, and nginx 1.25 deprecated the
# `listen … http2` form that older releases (Debian 11/12, Ubuntu 20.04–24.04) still need.
# On a bare IP there is no SNI to pick a site by, so this one is the port's default_server.
server {
    listen __PUBLIC_PORT__ ssl__DEFAULT_SERVER__;
    listen [::]:__PUBLIC_PORT__ ssl__DEFAULT_SERVER__;  # @IPV6@
    server_name __SERVER_NAME__;

    ssl_certificate     __CERT_DIR__/fullchain.pem;
    ssl_certificate_key __CERT_DIR__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:vm_ssl:10m;
    ssl_session_timeout 1h;

    server_tokens off;
    client_max_body_size 1m;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/acme;
        default_type text/plain;
    }

    location = /healthz {
        proxy_pass http://127.0.0.1:__NODE_PORT__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 10s;
        add_header Cache-Control "no-store";
    }

    # One DhtRpcRequest in, one DhtRpcResponse out, then the socket closes.
    location = /dht {
        limit_req zone=vm_dht burst=60 nodelay;
        proxy_pass http://127.0.0.1:__NODE_PORT__;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
        proxy_buffering off;
    }

    # Long-lived listener control channels and bridged circuits. The app sends
    # a keepalive frame every 40 s, so the idle timeout only guards dead peers.
    location = /relay {
        limit_conn vm_relay 256;
        proxy_pass http://127.0.0.1:__NODE_PORT__;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
        proxy_buffering off;
    }

    location / {
        return 404;
    }
}
