    <string name="feature_chat_group_audit_on_title">Turn on review?</string>
    <string name="feature_chat_group_audit_on_body">From now on, the text of messages in this group is kept before it is edited or deleted, and the group admins can see it. This is announced in the conversation and stays visible to every member. This setting has no effect on private conversations.</string>
