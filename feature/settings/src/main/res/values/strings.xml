    <string name="nodes_run_dev_label">توسعه محلی (DHT TCP)</string>
    <string name="nodes_run_dev_cmd">./gradlew :node:run --args=\"--tcp\"\n./scripts/emulator-connect.sh</string>
    <string name="nodes_run_add_hint">پس از راه‌اندازی، گره را با اسکن QR (کنار این راهنما) یا دکمه + اضافه کنید. QRها پس از نصب در ترمینال سرور هم نمایش داده می‌شوند.</string>
