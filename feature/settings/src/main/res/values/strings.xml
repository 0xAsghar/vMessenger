    <string name="nodes_run_intro">هر کسی می‌تواند نود بوت‌استرپ (DHT) یا رله اجرا کند. نود پیام‌ها را نمی‌خواند؛ فقط متادیتای امضا‌شدهٔ موقت را relay می‌کند.</string>
    <string name="nodes_run_install_label">نصب یک‌خطی (VPS، بدون دامنه)</string>
    <string name="nodes_run_install_one_liner">curl -fsSL https://raw.githubusercontent.com/0xAsghar/vMessenger/main/scripts/setup-node.sh | sudo bash -s --</string>
    <string name="nodes_run_build_label">ساخت دستی</string>
    <string name="nodes_run_build_manual">./gradlew :node:installDist</string>
    <string name="nodes_run_production_label">نصب از مخزن (گواهی openssl در /etc/vmessenger/tls/)</string>
    <string name="nodes_run_production_cmd">sudo ./scripts/setup-node.sh</string>
    <string name="nodes_run_dev_label">توسعه محلی (DHT TCP)</string>
    <string name="nodes_run_dev_cmd">./gradlew :node:run --args=\"--tcp\"\n./scripts/emulator-connect.sh</string>
    <string name="nodes_run_add_hint">پس از راه‌اندازی، نود را با اسکن QR (کنار این راهنما) یا دکمه + اضافه کنید. QRها پس از نصب در ترمینال سرور هم نمایش داده می‌شوند.</string>
    <string name="nodes_run_link_bootstrap_label">نمونه لینک بوت‌استرپ</string>
    <string name="nodes_run_link_bootstrap">vmnode:bootstrap:wss://relay.example/dht</string>
    <string name="nodes_run_link_relay_label">نمونه لینک رله</string>
