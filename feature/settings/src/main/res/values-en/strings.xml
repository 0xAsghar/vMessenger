    <string name="nodes_title">Network nodes</string>
    <string name="nodes_run_section">Running a node</string>
    <string name="nodes_run_guide_action">Node setup guide</string>
    <string name="nodes_run_intro">Anyone can run a bootstrap (DHT) node or a relay. A node does not read messages; it only relays short-lived signed metadata.</string>
    <string name="nodes_run_install_label">One-line install (VPS, no domain)</string>
    <string name="nodes_run_install_one_liner">curl -fsSL https://raw.githubusercontent.com/0xAsghar/vMessenger/main/scripts/setup-node.sh | sudo bash -s --</string>
    <string name="nodes_run_build_label">Manual build</string>
    <string name="nodes_run_build_manual">./gradlew :node:installDist</string>
    <string name="nodes_run_production_label">Install from the repository (openssl certificate in /etc/vmessenger/tls/)</string>
    <string name="nodes_run_production_cmd">sudo ./scripts/setup-node.sh</string>
    <string name="nodes_run_dev_label">Local development (DHT TCP)</string>
    <string name="nodes_run_dev_cmd">./gradlew :node:run --args=\"--tcp\"\n./scripts/emulator-connect.sh</string>
    <string name="nodes_run_add_hint">Once it is running, add the node by scanning its QR code (next to this guide) or with the + button. The QR codes are also shown in the server terminal after install.</string>
    <string name="nodes_run_link_bootstrap_label">Example bootstrap link</string>
    <string name="nodes_run_link_bootstrap">vmnode:bootstrap:wss://relay.example/dht</string>
    <string name="nodes_run_link_relay_label">Example relay link</string>
    <string name="nodes_run_link_relay">vmnode:relay:wss://relay.example/relay</string>
