    <string name="settings_app_lock">App lock</string>
    <string name="settings_app_lock_body">A PIN is asked for before the app opens. This lock only covers the screen: messages are received and stored as usual, and nothing is added to the encryption of your data. Anyone with your unlocked device, root access or forensic tools reads just as much of your data with this lock as without it.</string>
    <string name="settings_app_lock_confirm_title">Turn on app lock?</string>
    <string name="settings_app_lock_confirm_action">Continue</string>
    <string name="settings_app_lock_change_pin">Change PIN</string>
    <string name="settings_app_lock_strict">Strict mode</string>
    <string name="settings_app_lock_strict_body">The database key is kept in the device hardware and does not come out until you prove your identity to the device; this is real protection for stored data. In exchange, no messages are received while the app is locked — no notification arrives and nothing is stored in the background.</string>
    <string name="settings_app_lock_strict_unsupported">This device runs an Android version older than %1$s and cannot keep the key in hardware.</string>
    <string name="settings_app_lock_change_failed">The lock settings were not changed. Unlock the device and try again.</string>
    <string name="settings_app_lock_strict_auth_title">Verify your identity</string>
    <string name="settings_app_lock_strict_auth_subtitle">Verify your identity so the database key can be handed to the device hardware.</string>
    <string name="settings_app_lock_strict_confirm_title">Turn on strict mode?</string>
    <string name="settings_app_lock_strict_confirm_body">Make a backup file first; this is serious. The database key is tied to the hardware of this one device, and if that key is lost — through a factory reset, or through some changes to your fingerprints and device lock — there is no way left to open your messages except from a backup file. From then on, no messages are received while the app is locked.</string>
    <string name="settings_app_lock_strict_confirm_action">Turn on</string>
    <string name="settings_app_lock_strict_failed">Strict mode could not be turned on, and nothing changed. Unlock the device with your PIN or fingerprint and try again.</string>
    <string name="settings_app_lock_timeout">Automatic lock</string>
    <string name="settings_app_lock_timeout_body">If the app stays in the background this long, it locks again.</string>
    <string name="settings_app_lock_timeout_title">Lock automatically after</string>
    <string name="settings_app_lock_timeout_immediate">Immediately</string>
    <string name="settings_app_lock_timeout_minutes">%1$s min</string>
    <string name="settings_app_lock_timeout_close">Close</string>
    <string name="settings_app_lock_wipe">Erase data after wrong PINs</string>
    <string name="settings_app_lock_wipe_confirm_title">Turn on erasing data after wrong PINs?</string>
    <string name="settings_app_lock_wipe_confirm_body">After several wrong PIN entries, your identity, your keys and all conversations are erased. This cannot be undone, and holding the phone is all it takes to set it off; a child playing with it, or someone who wants your data destroyed, can trigger it too. If you do not have a backup file, make one first.</string>
    <string name="settings_app_lock_wipe_confirm_action">Turn on</string>
